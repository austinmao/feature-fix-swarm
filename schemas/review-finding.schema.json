{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://feature-fix-swarm/schemas/review-finding.schema.json",
  "title": "review-finding",
  "description": "Spec-004 AC-006: shared finding schema emitted by any reviewer dispatch (plan-wall.sh, review-gate, adversary-host.sh rungs). Root is a JSON array; an empty array is a SUCCESSFUL zero-findings review, not a failure. Zero-byte/non-JSON output is a rung failure at the dispatch layer, not a schema violation.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["severity", "file", "claim"],
    "additionalProperties": false,
    "properties": {
      "severity": {
        "type": "string",
        "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
      },
      "file": {
        "type": "string",
        "description": "repo-relative path"
      },
      "claim": {
        "type": "string"
      },
      "line": {
        "type": ["integer", "null"],
        "minimum": 1
      },
      "repro": {
        "type": ["string", "null"]
      },
      "vendor": {
        "type": "string",
        "enum": ["anthropic", "openai"]
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  }
}
