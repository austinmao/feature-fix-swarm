@@ -0,0 +1,491 @@
+#!/usr/bin/env node
+'use strict';
+
+/**
+ * FFS compatibility transport for @opengsd/gsd-core 1.14.
+ *
+ * The supervisor is deliberately an external process.  GSD owns wave order,
+ * prompt construction, initial HEAD capture, and integration/cleanup; FFS
+ * owns admission and the child process boundary.  One invocation represents
+ * one already allocated wave, so a supervisor cannot launch a partial wave.
+ */
+
+const crypto = require('node:crypto');
+const fs = require('node:fs');
+const path = require('node:path');
+const { spawn } = require('node:child_process');
+
+const SCHEMA = 'ffs.gsd-supervised-dispatch/v1';
+const MODE = 'ffs-supervised-process';
+const ADMISSION_EXIT = 78;
+const MAX_REPLY_BYTES = 16 * 1024 * 1024;
+
+function fail(message, code = 2) {
+  process.stderr.write(`ffs-supervised-dispatch: ${message}\n`);
+  process.exitCode = code;
+}
+
+function option(name) {
+  const index = process.argv.indexOf(name);
+  return index < 0 ? null : process.argv[index + 1] || null;
+}
+
+function isSha(value, length) {
+  return typeof value === 'string' && new RegExp(`^[0-9a-f]{${length}}$`).test(value);
+}
+
+function safeRelativeList(value, field) {
+  if (!Array.isArray(value) || value.length > 512 || value.some((item) => (
+    typeof item !== 'string' || !item || Buffer.byteLength(item, 'utf8') > 512 ||
+    path.isAbsolute(item) || item.includes('\\') || item.includes('\0') ||
+    item.split('/').some((part) => !part || part === '.' || part === '..')
+  ))) {
+    throw new Error(`${field} must contain safe relative paths`);
+  }
+  return value;
+}
+
+function patchPaths(value, field) {
+  const found = new Set();
+  for (const line of value.split(/\r?\n/)) {
+    if (!line.startsWith('diff --git ')) continue;
+    const match = /^diff --git a\/(\S+) b\/(\S+)$/.exec(line);
+    if (!match) throw new Error(`${field} contains an unsupported or quoted path header`);
+    for (const item of match.slice(1)) {
+      const safe = safeRelativeList([item], field)[0];
+      found.add(safe);
+    }
+  }
+  if (found.size === 0) throw new Error(`${field} contains no Git diff paths`);
+  return [...found];
+}
+
+function readJson(file) {
+  try {
+    const raw = fs.readFileSync(file, 'utf8');
+    const value = JSON.parse(raw);
+    if (Buffer.byteLength(raw, 'utf8') > 16 * 1024 || raw !== canonicalJson(value)) {
+      throw new Error('manifest is not bounded canonical JSON');
+    }
+    return value;
+  } catch (error) {
+    throw new Error(`cannot read manifest ${file}: ${error.message}`);
+  }
+}
+
+function canonicalJson(value) {
+  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(',')}]`;
+  if (value && typeof value === 'object') {
+    return `{${Object.keys(value).sort().map((key) => (
+      `${JSON.stringify(key)}:${canonicalJson(value[key])}`
+    )).join(',')}}`;
+  }
+  const encoded = JSON.stringify(value);
+  if (encoded === undefined) throw new Error('manifest contains an unsupported JSON value');
+  return encoded;
+}
+
+function validateManifest(manifest) {
+  const manifestKeys = ['admission', 'apply_between_waves', 'commit_mode', 'initial_head', 'mode',
+    'orchestrator_root', 'phase', 'plans', 'schema', 'wave'];
+  if (!manifest || Array.isArray(manifest) ||
+      JSON.stringify(Object.keys(manifest).sort()) !== JSON.stringify(manifestKeys) ||
+      manifest.schema !== SCHEMA || manifest.mode !== MODE) {
+    throw new Error(`manifest must declare schema ${SCHEMA} and mode ${MODE}`);
+  }
+  if (typeof manifest.orchestrator_root !== 'string' || !path.isAbsolute(manifest.orchestrator_root) ||
+      manifest.orchestrator_root.includes('\0') || Buffer.byteLength(manifest.orchestrator_root, 'utf8') > 4096) {
+    throw new Error('orchestrator_root must be a bounded absolute path');
+  }
+  if (!isSha(manifest.initial_head, 40)) throw new Error('initial_head must be a 40-character commit');
+  if (!Number.isSafeInteger(manifest.wave) || manifest.wave < 1) throw new Error('wave must be a positive integer');
+  if (typeof manifest.phase !== 'string' || !manifest.phase || Buffer.byteLength(manifest.phase, 'utf8') > 128) throw new Error('phase is required');
+  const admissionKeys = ['activity_id', 'available', 'generation', 'repository_id', 'run_id', 'runtime_identity', 'schema', 'workspace'];
+  if (!manifest.admission || JSON.stringify(Object.keys(manifest.admission).sort()) !== JSON.stringify(admissionKeys)
+      || manifest.admission.schema !== 'ffs.supervisor-admission/v1' || manifest.admission.available !== true
+      || !Number.isSafeInteger(manifest.admission.generation) || manifest.admission.generation < 1
+      || ['activity_id', 'repository_id', 'run_id', 'runtime_identity', 'workspace'].some(
+        (key) => typeof manifest.admission[key] !== 'string' || !manifest.admission[key]
+      ) || !path.isAbsolute(manifest.admission.workspace)) {
+    throw new Error('FFS admission is unavailable');
+  }
+  if (!['patches', 'fixture-commits'].includes(manifest.commit_mode)) {
+    throw new Error('commit_mode must be patches or fixture-commits');
+  }
+  if (!Array.isArray(manifest.plans) || manifest.plans.length === 0 || manifest.plans.length > 64) {
+    throw new Error('plans must contain the complete runnable wave');
+  }
+  const ids = new Set();
+  const dependencyIds = new Set();
+  for (const plan of manifest.plans) {
+    const planKeys = Object.keys(plan || {}).sort();
+    const expectedPlanKeys = ['files_deleted', 'files_modified', 'id', 'initial_head', 'prompt',
+      'prompt_fresh', 'prompt_nonce', 'prompt_sha256'];
+    const expectedPlanKeysWithDependencies = ['depends_on', ...expectedPlanKeys].sort();
+    if (!plan || Array.isArray(plan) || (JSON.stringify(planKeys) !== JSON.stringify(expectedPlanKeys)
+        && JSON.stringify(planKeys) !== JSON.stringify(expectedPlanKeysWithDependencies))
+        || typeof plan.id !== 'string' || !plan.id || Buffer.byteLength(plan.id, 'utf8') > 128 || ids.has(plan.id)) {
+      throw new Error('plan ids must be non-empty and unique');
+    }
+    ids.add(plan.id);
+    if (plan.initial_head !== manifest.initial_head) {
+      throw new Error(`plan ${plan.id} initial_head differs from the measured wave HEAD`);
+    }
+    if (plan.prompt_fresh !== true || typeof plan.prompt !== 'string' || !plan.prompt || Buffer.byteLength(plan.prompt, 'utf8') > 8192) {
+      throw new Error(`plan ${plan.id} must carry a fresh prompt`);
+    }
+    const promptHash = crypto.createHash('sha256').update(plan.prompt, 'utf8').digest('hex');
+    if (plan.prompt_sha256 !== promptHash) throw new Error(`plan ${plan.id} prompt hash mismatch`);
+    if (typeof plan.prompt_nonce !== 'string' || !plan.prompt_nonce || Buffer.byteLength(plan.prompt_nonce, 'utf8') > 256) {
+      throw new Error(`plan ${plan.id} prompt nonce is required`);
+    }
+    safeRelativeList(plan.files_modified, `plan ${plan.id} files_modified`);
+    safeRelativeList(plan.files_deleted, `plan ${plan.id} files_deleted`);
+    const dependencies = plan.depends_on === undefined ? [] : plan.depends_on;
+    if (!Array.isArray(dependencies) || dependencies.length > 64) {
+      throw new Error(`plan ${plan.id} has invalid dependencies`);
+    }
+    for (const dependency of dependencies) {
+      if (typeof dependency !== 'string' || !dependency || dependency === plan.id) {
+          throw new Error(`plan ${plan.id} has an invalid dependency`);
+        }
+        dependencyIds.add(dependency);
+    }
+  }
+  if ([...dependencyIds].some((id) => ids.has(id))) {
+    throw new Error('allocated wave contains an unresolved internal dependency');
+  }
+  if (typeof manifest.apply_between_waves !== 'boolean' || manifest.apply_between_waves !== true) {
+    throw new Error('supervisor must return material for integration between waves');
+  }
+  return manifest;
+}
+
+function commandFromEnvironment() {
+  const encoded = process.env.FFS_SUPERVISED_DISPATCH_COMMAND_JSON;
+  if (!encoded) throw new Error('FFS_SUPERVISED_DISPATCH_COMMAND_JSON is unset');
+  let command;
+  try { command = JSON.parse(encoded); } catch (error) { throw new Error(`invalid supervisor command JSON: ${error.message}`); }
+  if (!Array.isArray(command) || command.length === 0 || command.some((part) => typeof part !== 'string' || !part || part.includes('\0'))) {
+    throw new Error('supervisor command must be a non-empty argv array');
+  }
+  return command;
+}
+
+function validateReply(reply, manifest) {
+  if (!reply || reply.schema !== SCHEMA || reply.mode !== MODE || reply.wave !== manifest.wave) {
+    throw new Error('supervisor reply has the wrong schema, mode, or wave');
+  }
+  if (reply.initial_head !== manifest.initial_head) throw new Error('supervisor changed initial_head');
+  if (reply.apply_between_waves !== true) throw new Error('supervisor did not opt into between-wave integration');
+  if (!Array.isArray(reply.results) || reply.results.length !== manifest.plans.length) {
+    throw new Error('supervisor must return one result for every allocated plan');
+  }
+  const expected = new Map(manifest.plans.map((plan) => [plan.id, plan]));
+  const seen = new Set();
+  for (const result of reply.results) {
+    const plan = expected.get(result && result.plan_id);
+    if (!plan || seen.has(result.plan_id)) throw new Error('supervisor returned an unknown or duplicate plan');
+    seen.add(result.plan_id);
+    if (!['complete', 'failed'].includes(result.status)) throw new Error(`plan ${plan.id} has an invalid status`);
+    if (typeof result.summary !== 'string' || !result.summary) throw new Error(`plan ${plan.id} has no summary`);
+    const changed = safeRelativeList(result.changed_files || [], `plan ${plan.id} changed_files`);
+    const declared = new Set([...plan.files_modified, ...plan.files_deleted]);
+    if (changed.some((file) => !declared.has(file))) throw new Error(`plan ${plan.id} returned an out-of-scope file`);
+    if (manifest.commit_mode === 'patches') {
+      if (typeof result.patch !== 'string') throw new Error(`plan ${plan.id} must return patch material`);
+      if (result.commit !== undefined) throw new Error(`plan ${plan.id} attempted a repository commit in patch mode`);
+      const actual = result.patch ? patchPaths(result.patch, `plan ${plan.id} patch`) : [];
+      if (result.status === 'failed' && (result.patch || changed.length)) {
+        throw new Error(`failed plan ${plan.id} cannot return integration material`);
+      }
+      if (result.status === 'complete' && changed.length > 0 && !result.patch) {
+        throw new Error(`plan ${plan.id} must return a scoped patch for changed files`);
+      }
+      if (actual.some((file) => !declared.has(file))) {
+        throw new Error(`plan ${plan.id} patch contains an out-of-scope file`);
+      }
+      if (actual.length !== changed.length || actual.some((file) => !changed.includes(file))) {
+        throw new Error(`plan ${plan.id} changed_files does not match its patch paths`);
+      }
+    } else if (typeof result.commit !== 'string' || !isSha(result.commit, 40)) {
+      throw new Error(`fixture plan ${plan.id} must return a commit SHA`);
+    }
+  }
+  if (seen.size !== expected.size) throw new Error('supervisor omitted an allocated plan');
+  return reply;
+}
+
+function launch(command, manifest) {
+  return new Promise((resolve, reject) => {
+    const child = spawn(command[0], command.slice(1), {
+      cwd: manifest.orchestrator_root,
+      env: { ...process.env, FFS_SUPERVISED_DISPATCH_MODE: MODE },
+      stdio: ['pipe', 'pipe', 'inherit'],
+      shell: false,
+    });
+    const chunks = [];
+    let bytes = 0;
+    child.stdout.on('data', (chunk) => {
+      bytes += chunk.length;
+      if (bytes > MAX_REPLY_BYTES) child.kill('SIGTERM');
+      else chunks.push(chunk);
+    });
+    child.on('error', (error) => reject(error));
+    child.on('close', (code, signal) => {
+      if (signal || code !== 0) return reject(new Error(`supervisor exited ${signal || code}`));
+      try { resolve(JSON.parse(Buffer.concat(chunks).toString('utf8'))); }
+      catch (error) { reject(new Error(`invalid supervisor reply: ${error.message}`)); }
+    });
+    // The Python authority deliberately accepts only canonical JSON bytes so
+    // the retained manifest hash is stable across the Node/Python boundary.
+    child.stdin.end(canonicalJson(manifest));
+  });
+}
+
+const MAX_WRITE_MANIFEST_RAW_BYTES = 64 * 1024;
+const MAX_WRITE_MANIFEST_CANONICAL_BYTES = 16 * 1024;
+
+// Reads stdin to completion, bounded to maxBytes. Resolves on 'end' (the
+// event a file redirected onto stdin reliably emits); a plain pipe emits
+// both 'end' and 'close', so listening on 'end' alone still drains pipes
+// correctly. 'close' without a prior 'end' (a premature close) is treated
+// as a failure. Once one outcome has settled, later events are no-ops.
+function readStdinBounded(maxBytes) {
+  return new Promise((resolve, reject) => {
+    const chunks = [];
+    let bytes = 0;
+    let settled = false;
+    const settle = (fn, value) => {
+      if (settled) return;
+      settled = true;
+      fn(value);
+    };
+    process.stdin.on('data', (chunk) => {
+      bytes += chunk.length;
+      if (bytes > maxBytes) {
+        settle(reject, new Error(`manifest JSON on stdin exceeds the ${maxBytes} byte bound`));
+        process.stdin.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    process.stdin.on('error', (error) => settle(reject, error));
+    process.stdin.on('end', () => settle(resolve, Buffer.concat(chunks)));
+    process.stdin.on('close', () => settle(reject, new Error('manifest JSON on stdin closed before it ended')));
+  });
+}
+
+// Executors write wave manifests with keys in whatever order they build the
+// object; only this process's own canonicalJson() defines "canonical". This
+// mode reads a bounded raw manifest from stdin, requires it to decode as
+// strict UTF-8 and parse as JSON, requires its canonical form to fit the
+// same 16 KiB bound the strict --manifest check enforces, and requires it
+// to pass the same validateManifest() the strict --manifest check runs.
+// Only then is anything written to disk: the canonical bytes go to a
+// private temporary file created in the manifest's own directory
+// (O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW, mode 0600, fsynced before closing),
+// and that temporary file is published at the target path with a hard
+// link, so an existing file or a symlink already at the target path is
+// refused with EEXIST rather than overwritten or followed. The temporary
+// file has a short name of its own, so a long target name cannot push it
+// past the filesystem's name limit. Once this process has created the
+// temporary file it attempts to remove it, whether the link succeeded or
+// not; it never removes a name it did not create. The manifest's directory
+// is fsynced once the link succeeds so the new directory entry is durable,
+// mirroring what `publish()` does for the result and receipt files below.
+// If the removal fails after a successful link, the directory fsync is
+// still attempted, and the writer then fails instead of reporting success;
+// its message names the leftover file and, if the fsync also failed, the
+// fsync error. After an earlier failure, the earlier error is the one
+// reported.
+async function writeManifestFromStdin(targetPath) {
+  const raw = await readStdinBounded(MAX_WRITE_MANIFEST_RAW_BYTES);
+  let text;
+  try {
+    text = new TextDecoder('utf-8', { fatal: true }).decode(raw);
+  } catch (error) {
+    throw new Error(`manifest JSON on stdin is not valid UTF-8: ${error.message}`);
+  }
+  let value;
+  try {
+    value = JSON.parse(text);
+  } catch (error) {
+    throw new Error(`manifest JSON on stdin is invalid: ${error.message}`);
+  }
+  const canonical = Buffer.from(canonicalJson(value), 'utf8');
+  if (canonical.length > MAX_WRITE_MANIFEST_CANONICAL_BYTES) {
+    throw new Error(`manifest JSON on stdin exceeds the ${MAX_WRITE_MANIFEST_CANONICAL_BYTES} byte canonical bound`);
+  }
+  validateManifest(value);
+  const directory = path.dirname(targetPath);
+  const temporaryPath = path.join(
+    directory,
+    `.ffs-manifest.${process.pid}.${crypto.randomBytes(8).toString('hex')}.tmp`,
+  );
+  // Outside the cleanup scope: if exclusive creation fails, this process
+  // created nothing, and the name may belong to someone else.
+  const fd = fs.openSync(temporaryPath, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL | fs.constants.O_NOFOLLOW, 0o600);
+  let primaryError = null;
+  try {
+    try {
+      fs.writeFileSync(fd, canonical);
+      fs.fsyncSync(fd);
+    } finally {
+      fs.closeSync(fd);
+    }
+    try {
+      fs.linkSync(temporaryPath, targetPath);
+    } catch (error) {
+      if (error.code === 'EEXIST') {
+        throw new Error(`refusing to write manifest: target path already exists or is a symlink (EEXIST): ${targetPath}`);
+      }
+      throw error;
+    }
+  } catch (error) {
+    primaryError = error;
+  }
+  let cleanupError = null;
+  try {
+    fs.unlinkSync(temporaryPath);
+  } catch (error) {
+    cleanupError = error;
+  }
+  if (primaryError) throw primaryError;
+  // The link succeeded: make the published entry durable even if cleanup
+  // failed, then report the cleanup failure.
+  let fsyncError = null;
+  try {
+    const directoryFd = fs.openSync(directory, fs.constants.O_RDONLY | fs.constants.O_DIRECTORY);
+    try {
+      fs.fsyncSync(directoryFd);
+    } finally {
+      fs.closeSync(directoryFd);
+    }
+  } catch (error) {
+    fsyncError = error;
+  }
+  const failures = [];
+  if (fsyncError) failures.push(`its directory could not be fsynced: ${fsyncError.message}`);
+  if (cleanupError) failures.push(`its temporary file ${temporaryPath} could not be removed: ${cleanupError.message}`);
+  if (failures.length) {
+    throw new Error(`manifest was linked at ${targetPath}, but ${failures.join('; and ')}`);
+  }
+}
+
+const DETACHED_ENV = 'FFS_SUPERVISED_DISPATCH_DETACHED';
+
+// The orchestrator that runs this command may end its turn and have its
+// process group killed while the supervisor still owes the wave reply. The
+// whole flow (launch, reply wait, validation, publish) therefore runs in a
+// detached copy of this script: a new session, so a signal to this process
+// group or a hangup never reaches it, with the same parent chain, so FFS
+// admission still proves ancestry while the orchestrator lives. Its output
+// goes to a private log beside the result, never to a pipe this process
+// owns; the log's name is removed as soon as the child holds it, so nothing
+// is left behind if this foreground is killed. This foreground waits for the
+// child and relays its log and exit code, so a caller that stays sees no
+// difference; a caller that leaves still gets the result and receipt.
+function runDetached(outputPath) {
+  const log = `${outputPath}.${crypto.randomBytes(8).toString('hex')}.log`;
+  let fd;
+  try {
+    fd = fs.openSync(log, fs.constants.O_RDWR | fs.constants.O_CREAT | fs.constants.O_EXCL | fs.constants.O_NOFOLLOW, 0o600);
+  } catch (error) {
+    return fail(`cannot create private dispatch log: ${error.message}`, 1);
+  }
+  let child;
+  try {
+    child = spawn(process.execPath, [...process.execArgv, __filename, ...process.argv.slice(2)], {
+      detached: true,
+      env: { ...process.env, [DETACHED_ENV]: '1' },
+      stdio: ['ignore', fd, fd],
+    });
+  } finally {
+    fs.unlinkSync(log);
+  }
+  child.on('error', (error) => {
+    fs.closeSync(fd);
+    fail(`cannot start detached dispatch: ${error.message}`, 1);
+  });
+  child.on('exit', (code) => {
+    try {
+      // The child shares this descriptor's offset, so read from 0 by position.
+      const bytes = Buffer.alloc(fs.fstatSync(fd).size);
+      for (let offset = 0, read = 1; offset < bytes.length && read > 0; offset += read) {
+        read = fs.readSync(fd, bytes, offset, bytes.length - offset, offset);
+      }
+      process.stderr.write(bytes);
+    } catch (error) {
+      process.stderr.write(`ffs-supervised-dispatch: cannot relay the dispatch log: ${error.message}\n`);
+    } finally {
+      fs.closeSync(fd);
+    }
+    process.exitCode = code === null ? 1 : code;
+  });
+}
+
+async function main() {
+  const writeManifestPath = option('--write-manifest');
+  if (writeManifestPath) {
+    try {
+      await writeManifestFromStdin(writeManifestPath);
+    } catch (error) {
+      return fail(error.message, 1);
+    }
+    return;
+  }
+  const manifestPath = option('--manifest');
+  const outputPath = option('--output');
+  if (!manifestPath || !outputPath) return fail('usage: --manifest <file> --output <file>');
+  if (process.env[DETACHED_ENV] !== '1') return runDetached(outputPath);
+  try {
+    const manifest = validateManifest(readJson(manifestPath));
+    const command = commandFromEnvironment();
+    const digest = value => crypto.createHash('sha256').update(value).digest('hex');
+    const receiptPath = outputPath + '.receipt.json';
+    const manifestDigest = digest(canonicalJson(manifest));
+    const privateBytes = file => {
+      const fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW);
+      try {
+        const info = fs.fstatSync(fd);
+        if (!info.isFile() || info.nlink !== 1 || (info.mode & 0o777) !== 0o600 || info.uid !== process.getuid()) {
+          throw new Error('unsafe retained completion receipt');
+        }
+        return fs.readFileSync(fd);
+      } finally { fs.closeSync(fd); }
+    };
+    // Completion binds the entire frozen request, not merely plan IDs or HEAD.
+    // A partial publication is uncertain and must never launch a second wave.
+    const exists = file => { try { fs.lstatSync(file); return true; } catch (error) { if (error.code === 'ENOENT') return false; throw error; } };
+    if (exists(outputPath) || exists(receiptPath)) {
+      const raw = privateBytes(outputPath);
+      const receipt = JSON.parse(privateBytes(receiptPath).toString('utf8'));
+      const expected = {schema:'ffs.gsd-no-commit-completion/v1', manifest_sha256:manifestDigest,
+        result_sha256:digest(raw), initial_head:manifest.initial_head, commit_mode:manifest.commit_mode};
+      if (canonicalJson(receipt) !== canonicalJson(expected)) throw new Error('completion receipt input mismatch');
+      validateReply(JSON.parse(raw.toString('utf8')), manifest);
+      return;
+    }
+    const reply = validateReply(await launch(command, manifest), manifest);
+    const raw = `${JSON.stringify(reply, null, 2)}\n`;
+    const publish = (file, bytes) => {
+      const fd = fs.openSync(file, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL | fs.constants.O_NOFOLLOW, 0o600);
+      try { fs.writeFileSync(fd, bytes); fs.fsyncSync(fd); } finally { fs.closeSync(fd); }
+      const directory = fs.openSync(require('node:path').dirname(file), fs.constants.O_RDONLY | fs.constants.O_DIRECTORY);
+      try { fs.fsyncSync(directory); } finally { fs.closeSync(directory); }
+    };
+    publish(outputPath, raw);
+    publish(receiptPath, JSON.stringify({schema:'ffs.gsd-no-commit-completion/v1',
