{
  "mode": "yolo",
  "model_profile": "balanced",
  "granularity": "coarse",
  "parallelization": true,
  "resolve_model_ids": false,
  "model_overrides": {
    "gsd-planner": "fable",
    "gsd-plan-checker": "fable",
    "gsd-executor": "sonnet",
    "gsd-debugger": "sonnet",
    "gsd-phase-researcher": "sonnet",
    "gsd-project-researcher": "sonnet",
    "gsd-research-synthesizer": "sonnet",
    "gsd-codebase-mapper": "sonnet",
    "gsd-verifier": "opus",
    "gsd-code-reviewer": "opus",
    "gsd-integration-checker": "opus",
    "gsd-nyquist-auditor": "opus"
  },
  "dynamic_routing": {
    "enabled": true,
    "tier_models": {
      "light": "haiku",
      "standard": "sonnet",
      "heavy": "opus"
    },
    "escalate_on_failure": true,
    "max_escalations": 2
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "tdd_mode": true,
    "test_command": "bash scripts/gsd/gates-test-command.sh",
    "code_review_command": "bash scripts/gsd/review-gate-command.sh",
    "context_guard_mode": "auto",
    "plan_review_convergence": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high"
  },
  "git": {
    "branching_strategy": "phase",
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}"
  },
  "review": {
    "default_reviewers": ["codex"],
    "models": {
      "codex": null
    }
  },
  "features": {
    "global_learnings": true
  },
  "mempalace": {
    "enabled": true,
    "capture_artifacts": true,
    "recall_on_discuss": true,
    "recall_on_plan": true,
    "memory_mode": "augment",
    "mirror_kg": false
  },
  "learnings": {
    "max_inject": 10
  },
  "hooks": {
    "context_warnings": true
  },
  "ship": {
    "pr_body_sections": []
  }
}
