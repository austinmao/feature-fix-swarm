{
  "mode": "yolo",
  "model_profile": "balanced",
  "granularity": "coarse",
  "parallelization": true,
  "resolve_model_ids": true,
  "model_overrides": {
    "gsd-planner": "claude-fable-5",
    "gsd-plan-checker": "claude-fable-5",
    "gsd-executor": "claude-sonnet-5",
    "gsd-debugger": "claude-sonnet-5",
    "gsd-phase-researcher": "claude-sonnet-5",
    "gsd-project-researcher": "claude-sonnet-5",
    "gsd-research-synthesizer": "claude-sonnet-5",
    "gsd-codebase-mapper": "claude-sonnet-5",
    "gsd-verifier": "claude-opus-4-8",
    "gsd-code-reviewer": "claude-opus-4-8",
    "gsd-integration-checker": "claude-opus-4-8",
    "gsd-nyquist-auditor": "claude-opus-4-8"
  },
  "dynamic_routing": {
    "enabled": true,
    "tier_models": {
      "light": "claude-haiku-4-5-20251001",
      "standard": "claude-sonnet-5",
      "heavy": "claude-opus-4-8"
    },
    "escalate_on_failure": true,
    "max_escalations": 2
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "tdd_mode": true,
    "test_command": "bash scripts/gsd/gates-test-command.sh",
    "code_review_command": "bash scripts/gsd/review-gate-command.sh",
    "context_guard_mode": "auto",
    "plan_review_convergence": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high"
  },
  "git": {
    "branching_strategy": "phase",
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}"
  },
  "review": {
    "default_reviewers": ["codex"],
    "models": {
      "codex": null
    }
  },
  "features": {
    "global_learnings": true
  },
  "learnings": {
    "max_inject": 10
  },
  "hooks": {
    "context_warnings": true
  },
  "ship": {
    "pr_body_sections": []
  }
}
